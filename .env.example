# Copy to .env at the repo root (git-ignored). Never commit real values.

# ---- Required ---------------------------------------------------------------
MONGO_URI=mongodb://127.0.0.1:27017/hackelite_db
# >= 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
NODE_ENV=development
API_PORT=5050
CLIENT_ORIGIN=http://localhost:5173

# ---- Roles ------------------------------------------------------------------
# The first admin is created from these on server start. Password must satisfy the policy (10+ chars, mixed case, digit, symbol).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Plans ------------------------------------------------------------------
# Comma-separated keys that unlock the Pro plan on the Plan page. Change before deploying.
PRO_ACTIVATION_KEYS=HACKELITE-PRO-DEMO-2026

# ---- Optional integrations (leave blank to run fully offline) -----------------
# Google sign-in: Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web). Only this server variable is needed; the browser reads it from /api/auth/config.
GOOGLE_CLIENT_ID=
# Gemini: https://aistudio.google.com/apikey  (enables generated assistant answers; embeddings if EMBEDDINGS_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# local (default, no key) | gemini (gemini-embedding-001, 768 dims; listings re-embed automatically)
EMBEDDINGS_PROVIDER=local
# Email (password reset + digests), e.g. smtps://user:app-password@smtp.gmail.com:465
SMTP_URL=
MAIL_FROM=HackElite <no-reply@yourdomain>
APP_URL=http://localhost:5173
# Optional: `npm run integrations:check` also sends a test email here
SMTP_TEST_TO=

# ---- Ingestion ------------------------------------------------------------------
DISABLE_INGEST=false
# Comma-separated subset, e.g. unstop,devfolio,devpost. Blank = all 16 sources.
ENABLED_SOURCES=
INGEST_INTERVAL_MIN=60
# Currency conversion for prize ranking (estimates shown next to original amounts)
USD_TO_INR=84
EUR_TO_INR=91
GBP_TO_INR=107
# HTTP behaviour for adapters
INGEST_RETRIES=3
INGEST_TIMEOUT_MS=20000
INGEST_MIN_GAP_MS=400

# Key-gated sources (both free). Without them the source shows as "skipped" on Admin -> Sources.
# Kaggle: kaggle.com -> Settings -> API -> Create New Token (kaggle.json has username + key)
KAGGLE_USERNAME=
KAGGLE_KEY=
# clist.by: sign in -> https://clist.by/api/v4/doc/ shows your "ApiKey username:key"
CLIST_USERNAME=
CLIST_API_KEY=

# ---- Advanced / operations (all optional) --------------------------------------
# Serve the built React app from the API process (single-origin deployment, used by the Dockerfile). Run `npm run build` first.
SERVE_CLIENT=false
# Set to "off" to silence the per-request access log in development (JSON lines are always on in production)
ACCESS_LOG=
# Pwned Passwords breach check on sign-up / password change ("off" disables it, e.g. for offline CI)
HIBP_CHECK=
# DoraHacks blocks automated access; set this only to an endpoint you are authorised to use
DORAHACKS_API_URL=
# Development/CI ONLY (ignored in production): disables rate limiting, used by `npm run e2e`
DISABLE_RATE_LIMITS=
# Use a separate database name on the same MongoDB server (the test suites set this to stay isolated)
MONGO_DB_NAME=
# Gemini model overrides
GEMINI_EMBED_MODEL=
GEMINI_EMBED_DIMS=
