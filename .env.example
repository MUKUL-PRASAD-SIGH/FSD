# Copy to .env (already present in this repo's root, git-ignored)
MONGO_URI=mongodb://127.0.0.1:27017/hackelite_db
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
# API port (default 5050). PORT in the old project's .env is ignored.
API_PORT=5050
# Optional: set to true to skip the hourly Devpost refresh
DISABLE_INGEST=false
USD_TO_INR=84
# Optional: limit live sources, e.g. ENABLED_SOURCES=unstop,devfolio (default: all)
ENABLED_SOURCES=
